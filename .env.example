# Shopify Storefront API (public, publishable)
VITE_SHOPIFY_STOREFRONT_TOKEN=din_storefront_token
VITE_SHOPIFY_STORE_DOMAIN=din-butik.myshopify.com
VITE_SHOPIFY_STOREFRONT_API_VERSION=2025-01

# Shopify Admin API (server-side only, aldrig i klienten)
SHOPIFY_ACCESS_TOKEN=din_admin_token
SHOPIFY_STORE_DOMAIN=din-butik.myshopify.com
SHOPIFY_ADMIN_API_VERSION=2025-01

# Firecrawl (valfritt, för crawl av referenssajter)
FIRECRAWL_API_KEY=din_firecrawl_nyckel
